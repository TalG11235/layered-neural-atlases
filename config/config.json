{
    "input": {
        "path": "path/to/video.mp4",
        "frame_rate": 10 
        "video_name": ""
    },
    "preprocessing": {
        "resize": [1280, 720],
        "normalize": true
    },
    "training": {
        "epochs": 50,
        "batch_size": 16,
        "learning_rate": 0.001
    },
    "compression": {
        "method": "autoencoder",
        "target_size": "1MB"
    },
    "reconstruction": {
        "method": "upsampling",
        "output_size": [1920, 1080]
    }
}